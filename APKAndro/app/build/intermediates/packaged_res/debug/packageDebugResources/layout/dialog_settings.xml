<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Setting"
            android:textColor="@color/tefa_g9"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/settingBtnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_chip"
            android:contentDescription="Tutup Setting"
            android:padding="9dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/tefa_g1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="440dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- pH Min / Max -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="pH Min / Max"
                android:textColor="@color/tefa_g9"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/set_ph_min"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="-"
                    android:textColor="@color/tefa_mute"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/set_ph_max"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- EC Min / Max -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="EC (mS/cm) Min / Max"
                android:textColor="@color/tefa_g9"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/set_ec_min"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="-"
                    android:textColor="@color/tefa_mute"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/set_ec_max"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Suhu Udara Min / Max -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Suhu Udara (°C) Min / Max"
                android:textColor="@color/tefa_g9"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/set_temp_min"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="-"
                    android:textColor="@color/tefa_mute"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/set_temp_max"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Kelembapan Min / Max -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Kelembapan (% RH) Min / Max"
                android:textColor="@color/tefa_g9"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/set_hum_min"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:text="-"
                    android:textColor="@color/tefa_mute"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/set_hum_max"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:inputType="numberDecimal"
                    android:paddingHorizontal="12dp"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- Admin-only MQTT & Hydroponic Dosing Sections -->
            <LinearLayout
                android:id="@+id/adminMqttDosingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Koneksi Broker &amp; Topik MQTT"
                    android:textColor="@color/tefa_g5"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Broker MQTT (WebSocket URL / Host)"
                    android:textColor="@color/tefa_g9"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/set_mqtt_broker"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input_box"
                    android:hint="wss://broker.emqx.io:8084/mqtt"
                    android:inputType="textUri"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Topik Subscribe (Sensor)"
                    android:textColor="@color/tefa_g9"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/set_mqtt_topic_sub"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input_box"
                    android:hint="tefa/hidroponik/sensor"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Topik Publish (Control)"
                    android:textColor="@color/tefa_g9"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/set_mqtt_topic_pub"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input_box"
                    android:hint="tefa/hidroponik/control"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Topik Subscribe (Status)"
                    android:textColor="@color/tefa_g9"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/set_mqtt_topic_status"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_box"
                    android:hint="tefa/hidroponik/status"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Dosis &amp; Interval Hidroponik (MQTT)"
                    android:textColor="@color/tefa_g5"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Interval (menit)"
                            android:textColor="@color/tefa_g9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/set_interval_minutes"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_input_box"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="EC Target (mS/cm)"
                            android:textColor="@color/tefa_g9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/set_ec_target"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_input_box"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="pH Up Dose (detik)"
                            android:textColor="@color/tefa_g9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/set_ph_up_dose"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_input_box"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="pH Down Dose (detik)"
                            android:textColor="@color/tefa_g9"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/set_ph_down_dose"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_input_box"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:textSize="13.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- AI Asisten Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="AI Asisten"
                android:textColor="@color/tefa_g5"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Provider AI"
                android:textColor="@color/tefa_g9"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/set_ai_provider"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="API Key"
                android:textColor="@color/tefa_g9"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/set_ai_api_key"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_input_box"
                android:hint="Masukkan Gemini API Key (AIza...)..."
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setBtnReset"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:text="Reset Default"
            android:textAllCaps="false"
            android:textColor="@color/tefa_g9"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:strokeColor="@color/tefa_g2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setBtnSave"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="@color/tefa_g9"
            android:text="SAVE"
            android:textAllCaps="false"
            android:textColor="@color/tefa_white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
